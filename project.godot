; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Terminal Architect"
config/version="0.1.0-prototype"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
GameClock="*res://scripts/core/game_clock.gd"
BuildGrid="*res://scripts/building/build_grid.gd"
ObjectCatalog="*res://scripts/objects/object_catalog.gd"
Money="*res://scripts/economy/money.gd"
RunwayCatalog="*res://scripts/airside/runway_catalog.gd"
TaxiwayCatalog="*res://scripts/airside/taxiway_catalog.gd"
AircraftCatalog="*res://scripts/aircraft/aircraft_catalog.gd"
StandCatalog="*res://scripts/airside/stand_catalog.gd"
RampCatalog="*res://scripts/airside/ramp_catalog.gd"
AirlineCatalog="*res://scripts/airlines/airline_catalog.gd"
FlightSchedule="*res://scripts/flights/flight_schedule.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
